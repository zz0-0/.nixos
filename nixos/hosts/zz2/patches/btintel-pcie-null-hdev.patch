--- a/drivers/bluetooth/btintel_pcie.c
+++ b/drivers/bluetooth/btintel_pcie.c
@@ -297,12 +297,22 @@
 
 static inline void btintel_pcie_dump_debug_registers(struct hci_dev *hdev)
 {
-	struct btintel_pcie_data *data = hci_get_drvdata(hdev);
+	struct btintel_pcie_data *data;
 	u16 cr_hia, cr_tia;
 	u32 reg, mbox_reg;
 	struct sk_buff *skb;
 	u8 buf[80];
 
+	/* hdev is NULL until btintel_pcie_setup_hdev() has completed, but
+	 * interrupts can already be raised by the controller before that
+	 * (e.g. an early GP1 mailbox interrupt during probe). Do not
+	 * dereference a NULL hdev.
+	 */
+	if (!hdev)
+		return;
+
+	data = hci_get_drvdata(hdev);
+
 	skb = alloc_skb(1024, GFP_ATOMIC);
 	if (!skb)
 		return;
@@ -959,6 +969,10 @@
 
 static void btintel_pcie_msix_gp1_handler(struct btintel_pcie_data *data)
 {
+	/* A GP1 interrupt can arrive before setup_hdev() published data->hdev */
+	if (!data->hdev)
+		return;
+
 	bt_dev_err(data->hdev, "Received gp1 mailbox interrupt");
 	btintel_pcie_dump_debug_registers(data->hdev);
 }
